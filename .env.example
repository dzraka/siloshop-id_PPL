# ===========================================
# Database (Neon PostgreSQL)
# Daftar gratis di https://neon.tech
# Buat project baru -> copy connection string
# ===========================================
DATABASE_URL=
DIRECT_URL=

# Currency Symbol
NEXT_PUBLIC_CURRENCY_SYMBOL='Rp'

# ===========================================
# Clerk Authentication
# Daftar gratis di https://clerk.com
# Buat project baru -> copy API Keys untuk Next.js
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_EMAIL=

# ===========================================
# ImageKit (Untuk Penyimpanan Gambar)
# Daftar gratis di https://imagekit.io
# Masuk ke Developer Options -> copy API Keys
# ===========================================
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
